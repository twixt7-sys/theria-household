# Firebase web config.
#
# These values are NOT secrets. They ship in every client bundle and identify
# the project rather than authenticating it. Access is controlled by Firestore
# security rules and App Check.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# App Check (reCAPTCHA v3). Required in production; the debug token lets
# localhost attest during development.
VITE_RECAPTCHA_V3_SITE_KEY=
VITE_APPCHECK_DEBUG_TOKEN=

# NOTE: there is deliberately no Gemini API key here. Homi runs through
# Firebase AI Logic, which proxies the call server-side — the key never
# reaches the browser. See prompt0.md decision D1.
